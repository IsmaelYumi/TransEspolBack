  "item": [
    {
      "name": "01. Autenticación (Auth)",
      "description": "Endpoints de inicio de sesión institucional ESPOL y verificación de sesión.",
      "item": [
        {
          "name": "Login con Microsoft - Rol Administrador (Dev Mock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.tokens && json.tokens.accessToken) {",
                  "        pm.collectionVariables.set('authToken', json.tokens.accessToken);",
                  "        console.log('[TransEspol] Token ADMIN guardado en variable {{authToken}}');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"mock_espol_admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/microsoft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "microsoft"
              ]
            },
            "description": "Inicia sesión simulando una cuenta institucional de Administrador (`admin.transporte@espol.edu.ec`). Retorna y guarda automáticamente el token JWT en `{{authToken}}`."
          },
          "response": []
        },
