# ==============================================================================
# TransEspol Backend - Configuration Environment Template
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# PostgreSQL Database (Prisma 7)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transespol_db?schema=public"

# Redis Cache & Realtime Coordinates
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=transespol:
# Realtime coordinate cache time-to-live in seconds (e.g. 120s without ping marks bus offline)
REDIS_COORDINATES_TTL_SECONDS=120

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-espol-transit-2026-production-grade
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-espol-transit-2026
JWT_REFRESH_EXPIRES_IN=7d

# Microsoft Azure AD / Entra ID - Institutional Authentication (@espol.edu.ec)
MICROSOFT_CLIENT_ID=your-azure-ad-application-client-id
MICROSOFT_CLIENT_SECRET=your-azure-ad-client-secret
MICROSOFT_TENANT_ID=your-azure-ad-tenant-id-or-common
MICROSOFT_ALLOWED_DOMAIN=espol.edu.ec

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
